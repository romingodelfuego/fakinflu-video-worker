{
  "_comment": "fakinflu - Wan 2.2 Fun Control 5B (bf16, VAE 2.2) : previews moins cheres (entraine en 121 images a 24 fps). FORMAT API ComfyUI, converti depuis le template officiel video_wan2_2_5B_fun_control.json. Disponible seulement si l'image est buildee avec WITH_5B=1. Qualite nettement inferieure au 14B (avertissement du template officiel).",
  "_models_required": {
    "diffusion_models/wan2.2_fun_control_5B_bf16.safetensors": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged",
    "text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged",
    "vae/wan2.2_vae.safetensors": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged"
  },
  "_fakinflu": {
    "model": "5b",
    "prompt":   {"node": "pos", "key": "text"},
    "negative": {"node": "neg", "key": "text"},
    "control":  {"node": "ctrl_load", "key": "file"},
    "control_frames": "ctrl_frames",
    "canny": "canny",
    "ref":      {"node": "ref", "key": "image"},
    "cond": "cond",
    "fps":      {"node": "mkvideo", "key": "fps"},
    "save":     {"node": "save", "key": "filename_prefix"},
    "seed":     [{"node": "sampler", "key": "seed"}],
    "defaults": {"fps": 24, "max_frames": 121, "preset": "fast"},
    "presets": {
      "fast":    {"sampler.steps": 20, "sampler.cfg": 5.0},
      "quality": {"sampler.steps": 30, "sampler.cfg": 5.0}
    }
  },

  "unet": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Wan 2.2 Fun Control 5B (bf16)"},
    "inputs": {"unet_name": "wan2.2_fun_control_5B_bf16.safetensors", "weight_dtype": "default"}
  },
  "shift": {
    "class_type": "ModelSamplingSD3",
    "inputs": {"model": ["unet", 0], "shift": 8.0}
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "wan2.2_vae.safetensors"}
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "PLACEHOLDER_PROMPT", "clip": ["clip", 0]}
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走", "clip": ["clip", 0]}
  },
  "ctrl_load": {
    "class_type": "LoadVideo",
    "inputs": {"file": "control.mp4"}
  },
  "ctrl_frames": {
    "class_type": "GetVideoComponents",
    "inputs": {"video": ["ctrl_load", 0]}
  },
  "canny": {
    "class_type": "Canny",
    "inputs": {"image": ["ctrl_frames", 0], "low_threshold": 0.1, "high_threshold": 0.6}
  },
  "ref": {
    "class_type": "LoadImage",
    "inputs": {"image": "ref.png"}
  },
  "cond": {
    "class_type": "Wan22FunControlToVideo",
    "inputs": {
      "positive": ["pos", 0],
      "negative": ["neg", 0],
      "vae": ["vae", 0],
      "width": 480,
      "height": 832,
      "length": 121,
      "batch_size": 1,
      "ref_image": ["ref", 0],
      "control_video": ["ctrl_frames", 0]
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["shift", 0],
      "seed": 0,
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0,
      "positive": ["cond", 0],
      "negative": ["cond", 1],
      "latent_image": ["cond", 2]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["sampler", 0], "vae": ["vae", 0]}
  },
  "mkvideo": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["decode", 0], "fps": 24.0}
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {"video": ["mkvideo", 0], "filename_prefix": "fakinflu/video", "format": "mp4", "format.codec": "h264"}
  }
}
