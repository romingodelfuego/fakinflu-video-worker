{
  "_comment": "fakinflu - Wan 2.2 Fun Control 14B (fp8, MoE high/low noise) : video de controle (pose/depth/clay->canny) + image de reference -> video. FORMAT API ComfyUI, converti depuis le template officiel Comfy-Org/workflow_templates video_wan2_2_14B_fun_control.json (variante 4 pas lightx2v + variante 20 pas). Nodes 100% natifs, ComfyUI >= 0.34.0. Le handler (handler.py) remplit les champs decrits dans _fakinflu ; les cles commencant par _ sont retirees avant envoi.",
  "_models_required": {
    "diffusion_models/wan2.2_fun_control_high_noise_14B_fp8_scaled.safetensors": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged",
    "diffusion_models/wan2.2_fun_control_low_noise_14B_fp8_scaled.safetensors": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged",
    "text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged",
    "vae/wan_2.1_vae.safetensors": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged",
    "loras/wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged (lightx2v, Apache-2.0)",
    "loras/wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged (lightx2v, Apache-2.0)"
  },
  "_fakinflu": {
    "model": "14b",
    "prompt":   {"node": "pos", "key": "text"},
    "negative": {"node": "neg", "key": "text"},
    "control":  {"node": "ctrl_load", "key": "file"},
    "control_frames": "ctrl_frames",
    "canny": "canny",
    "ref":      {"node": "ref", "key": "image"},
    "cond": "cond",
    "fps":      {"node": "mkvideo", "key": "fps"},
    "save":     {"node": "save", "key": "filename_prefix"},
    "seed":     [{"node": "sampler_high", "key": "noise_seed"}],
    "defaults": {"fps": 16, "max_frames": 81, "preset": "fast"},
    "presets": {
      "fast": {
        "lora_high.strength_model": 1.0, "lora_low.strength_model": 1.0,
        "sampler_high.steps": 4, "sampler_high.cfg": 1.0, "sampler_high.end_at_step": 2,
        "sampler_low.steps": 4, "sampler_low.cfg": 1.0, "sampler_low.start_at_step": 2
      },
      "quality": {
        "lora_high.strength_model": 0.0, "lora_low.strength_model": 0.0,
        "sampler_high.steps": 20, "sampler_high.cfg": 3.5, "sampler_high.end_at_step": 10,
        "sampler_low.steps": 20, "sampler_low.cfg": 3.5, "sampler_low.start_at_step": 10
      }
    }
  },

  "unet_high": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Wan 2.2 Fun Control 14B high noise (fp8)"},
    "inputs": {"unet_name": "wan2.2_fun_control_high_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default"}
  },
  "unet_low": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Wan 2.2 Fun Control 14B low noise (fp8)"},
    "inputs": {"unet_name": "wan2.2_fun_control_low_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default"}
  },
  "lora_high": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "lightx2v 4 pas (high) - strength 0 = desactive"},
    "inputs": {"model": ["unet_high", 0], "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors", "strength_model": 1.0}
  },
  "lora_low": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "lightx2v 4 pas (low) - strength 0 = desactive"},
    "inputs": {"model": ["unet_low", 0], "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors", "strength_model": 1.0}
  },
  "shift_high": {
    "class_type": "ModelSamplingSD3",
    "inputs": {"model": ["lora_high", 0], "shift": 8.0}
  },
  "shift_low": {
    "class_type": "ModelSamplingSD3",
    "inputs": {"model": ["lora_low", 0], "shift": 8.0}
  },
  "clip": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "umt5 xxl fp8"},
    "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "wan_2.1_vae.safetensors"}
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Prompt positif"},
    "inputs": {"text": "PLACEHOLDER_PROMPT", "clip": ["clip", 0]}
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Prompt negatif (defaut officiel Wan)"},
    "inputs": {"text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走", "clip": ["clip", 0]}
  },
  "ctrl_load": {
    "class_type": "LoadVideo",
    "_meta": {"title": "Video de controle (pose/depth/clay)"},
    "inputs": {"file": "control.mp4"}
  },
  "ctrl_frames": {
    "class_type": "GetVideoComponents",
    "inputs": {"video": ["ctrl_load", 0]}
  },
  "canny": {
    "class_type": "Canny",
    "_meta": {"title": "Canny (seulement pour control=clay, retire sinon)"},
    "inputs": {"image": ["ctrl_frames", 0], "low_threshold": 0.1, "high_threshold": 0.6}
  },
  "ref": {
    "class_type": "LoadImage",
    "_meta": {"title": "Planche de reference des personnages"},
    "inputs": {"image": "ref.png"}
  },
  "cond": {
    "class_type": "Wan22FunControlToVideo",
    "inputs": {
      "positive": ["pos", 0],
      "negative": ["neg", 0],
      "vae": ["vae", 0],
      "width": 480,
      "height": 832,
      "length": 81,
      "batch_size": 1,
      "ref_image": ["ref", 0],
      "control_video": ["ctrl_frames", 0]
    }
  },
  "sampler_high": {
    "class_type": "KSamplerAdvanced",
    "_meta": {"title": "Expert high noise (debut du debruitage)"},
    "inputs": {
      "model": ["shift_high", 0],
      "add_noise": "enable",
      "noise_seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["cond", 0],
      "negative": ["cond", 1],
      "latent_image": ["cond", 2],
      "start_at_step": 0,
      "end_at_step": 2,
      "return_with_leftover_noise": "enable"
    }
  },
  "sampler_low": {
    "class_type": "KSamplerAdvanced",
    "_meta": {"title": "Expert low noise (fin du debruitage)"},
    "inputs": {
      "model": ["shift_low", 0],
      "add_noise": "disable",
      "noise_seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["cond", 0],
      "negative": ["cond", 1],
      "latent_image": ["sampler_high", 0],
      "start_at_step": 2,
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["sampler_low", 0], "vae": ["vae", 0]}
  },
  "mkvideo": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["decode", 0], "fps": 16.0}
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {"video": ["mkvideo", 0], "filename_prefix": "fakinflu/video", "format": "mp4", "format.codec": "h264"}
  }
}
